# Blacktail: environment variables
#
# The app checks all four at startup and names anything missing.
# Local dev: copy this file to .env.local (gitignored) and fill it in.
# On the Worker the plain values are in wrangler.jsonc "vars"; only the secret is set with wrangler.

# The store's address name: More > Online store address in How many
STORE_SLUG=your-store-slug

# The API address exactly as that panel shows it; it must end in /stores/<STORE_SLUG>
HOWMANY_API_URL=https://www.checkhowmany.com/api/v1/stores/your-store-slug

# The webhook secret copied from the same panel (at least 16 characters).
# On the Worker: npx wrangler secret put HOWMANY_WEBHOOK_SECRET. Never put it in wrangler.jsonc.
HOWMANY_WEBHOOK_SECRET=

# The public address of the site (https only)
SITE_URL=https://www.example.com
